<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build settings and the common game references live in Directory.Build.props at the mod root.
       This file names the plugin and adds the assemblies that only this mod uses. -->
  <PropertyGroup>
    <AssemblyName>BetterCrafting</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- R3 has the ReactiveProperty of the workbench window state (the owner ids of the bag, drawer, and workbench grid).
       ObservableCollections has the ObservableList of the recipe list. -->
  <ItemGroup>
    <_Ref Include="$(BepInExInterop)\R3.dll" />
    <_Ref Include="$(BepInExInterop)\ObservableCollections.dll" />
    <Reference Include="@(_Ref)">
      <HintPath>%(FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
